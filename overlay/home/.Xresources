Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xcursor.theme: Adwaita
XTerm*termName: xterm-256color
XTerm*faceName: JetBrains Mono:size=10.5
XTerm*renderFont: true
XTerm*internalBorder: 12
XTerm*scrollBar: false
XTerm*saveLines: 4000
XTerm*selectToClipboard: true
XTerm*cursorBlink: false
XTerm*VT100.translations: #override Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n Ctrl Shift <Key>V: insert-selection(CLIPBOARD)
XTerm*background: #1a1b26
XTerm*foreground: #c0caf5
XTerm*cursorColor: #7aa2f7
XTerm*color0: #15161e
XTerm*color1: #f7768e
XTerm*color2: #9ece6a
XTerm*color3: #e0af68
XTerm*color4: #7aa2f7
XTerm*color5: #bb9af7
XTerm*color6: #7dcfff
XTerm*color7: #a9b1d6
XTerm*color8: #414868
XTerm*color9: #ff899d
XTerm*color10: #9fe044
XTerm*color11: #faba4a
XTerm*color12: #8db0ff
XTerm*color13: #c7a9ff
XTerm*color14: #a4daff
XTerm*color15: #c0caf5
