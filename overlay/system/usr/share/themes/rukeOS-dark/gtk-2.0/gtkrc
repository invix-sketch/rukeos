gtk-font-name = "Inter 10"
gtk-icon-theme-name = "rukeOS"

style "ruke-default" {
  bg[NORMAL]      = "#1a1b26"
  bg[PRELIGHT]    = "#24283b"
  bg[SELECTED]    = "#9B45FF"
  bg[ACTIVE]      = "#24283b"
  bg[INSENSITIVE] = "#16161e"
  fg[NORMAL]      = "#c0caf5"
  fg[PRELIGHT]    = "#c0caf5"
  fg[SELECTED]    = "#ffffff"
  fg[ACTIVE]      = "#c0caf5"
  fg[INSENSITIVE] = "#565f89"
  base[NORMAL]      = "#1f2335"
  base[PRELIGHT]    = "#24283b"
  base[SELECTED]    = "#9B45FF"
  base[ACTIVE]      = "#24283b"
  base[INSENSITIVE] = "#16161e"
  text[NORMAL]      = "#c0caf5"
  text[PRELIGHT]    = "#c0caf5"
  text[SELECTED]    = "#ffffff"
  text[ACTIVE]      = "#c0caf5"
  text[INSENSITIVE] = "#565f89"
}
class "GtkWidget" style "ruke-default"
class "GtkWindow" style "ruke-default"
class "GtkEntry" style "ruke-default"
class "GtkTreeView" style "ruke-default"
class "GtkIconView" style "ruke-default"
