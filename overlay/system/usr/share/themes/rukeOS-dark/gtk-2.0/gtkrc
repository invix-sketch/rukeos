gtk-font-name = "Inter 10"
gtk-icon-theme-name = "rukeOS"
gtk-theme-name = "rukeOS-dark"

style "ruke-default" {
  bg[NORMAL]      = "#1a1b26"
  bg[PRELIGHT]    = "#24283b"
  bg[SELECTED]    = "#9B45FF"
  bg[ACTIVE]      = "#24283b"
  bg[INSENSITIVE] = "#16161e"
  fg[NORMAL]      = "#c0caf5"
  fg[PRELIGHT]    = "#c0caf5"
  fg[SELECTED]    = "#ffffff"
  fg[ACTIVE]      = "#c0caf5"
  fg[INSENSITIVE] = "#565f89"
  base[NORMAL]      = "#1a1b26"
  base[PRELIGHT]    = "#24283b"
  base[SELECTED]    = "#9B45FF"
  base[ACTIVE]      = "#1a1b26"
  base[INSENSITIVE] = "#16161e"
  text[NORMAL]      = "#c0caf5"
  text[PRELIGHT]    = "#c0caf5"
  text[SELECTED]    = "#ffffff"
  text[ACTIVE]      = "#c0caf5"
  text[INSENSITIVE] = "#565f89"
}

style "ruke-chrome" {
  bg[NORMAL]      = "#16161e"
  bg[PRELIGHT]    = "#24283b"
  bg[SELECTED]    = "#9B45FF"
  bg[ACTIVE]      = "#24283b"
  bg[INSENSITIVE] = "#16161e"
  fg[NORMAL]      = "#c0caf5"
  fg[PRELIGHT]    = "#c0caf5"
  fg[SELECTED]    = "#ffffff"
  fg[ACTIVE]      = "#c0caf5"
  fg[INSENSITIVE] = "#565f89"
  base[NORMAL]    = "#16161e"
  base[PRELIGHT]  = "#24283b"
  base[SELECTED]  = "#9B45FF"
  text[NORMAL]    = "#a9b1d6"
  text[SELECTED]  = "#ffffff"
}

class "GtkWidget" style "ruke-default"
class "GtkWindow" style "ruke-default"
class "GtkDialog" style "ruke-default"
class "GtkEntry" style "ruke-default"
class "GtkTextView" style "ruke-default"
class "GtkTreeView" style "ruke-default"
class "GtkIconView" style "ruke-default"
class "GtkList" style "ruke-default"
class "GtkCList" style "ruke-default"
class "GtkLabel" style "ruke-default"
class "GtkButton" style "ruke-default"
class "GtkToggleButton" style "ruke-default"
class "GtkCheckButton" style "ruke-default"
class "GtkRadioButton" style "ruke-default"
class "GtkComboBox" style "ruke-default"
class "GtkComboBoxText" style "ruke-default"
class "GtkSpinButton" style "ruke-default"
class "GtkScale" style "ruke-default"
class "GtkProgressBar" style "ruke-default"
class "GtkScrollbar" style "ruke-default"
class "GtkScrolledWindow" style "ruke-default"
class "GtkViewport" style "ruke-default"
class "GtkFrame" style "ruke-default"
class "GtkNotebook" style "ruke-chrome"
class "GtkToolbar" style "ruke-chrome"
class "GtkHandleBox" style "ruke-chrome"
class "GtkStatusbar" style "ruke-chrome"
class "GtkMenuBar" style "ruke-chrome"
class "GtkMenu" style "ruke-default"
class "GtkMenuItem" style "ruke-default"
class "GtkFileChooser" style "ruke-default"
class "GtkFileChooserDefault" style "ruke-default"
class "GtkFileChooserWidget" style "ruke-default"
class "GtkPlacesSidebar" style "ruke-chrome"
class "GtkPaned" style "ruke-default"
class "GtkBox" style "ruke-default"

widget_class "*Menu*"    style "ruke-default"
widget_class "*ToolBar*" style "ruke-chrome"
widget_class "*MenuBar*" style "ruke-chrome"
widget_class "*Status*"  style "ruke-chrome"
widget_class "*Tree*"    style "ruke-default"
widget_class "*IconView*" style "ruke-default"
widget_class "*FileChooser*" style "ruke-default"
widget_class "*Places*"  style "ruke-chrome"
widget_class "*Sidebar*" style "ruke-chrome"
widget_class "*Entry*"   style "ruke-default"
