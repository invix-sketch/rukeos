#!/bin/sh
# Themed rukeOS lock screen (i3lock-color) with VT-switch lock (physlock -l).
# Fallback: slock.
export NO_AT_BRIDGE=1 GTK_A11Y=none
[ -n "$DISPLAY" ] || exit 1

if pgrep -u "$(id -u)" -x i3lock >/dev/null 2>&1 || pgrep -u "$(id -u)" -x i3lock-color >/dev/null 2>&1 || pgrep -u "$(id -u)" -x slock >/dev/null 2>&1; then
  exit 0
fi

if command -v ruke-passwd >/dev/null && [ "$(sudo -n ruke-passwd status 2>/dev/null)" = none ]; then
  if command -v ruke-settings >/dev/null; then
    ruke-settings --page security --prompt-password >/dev/null 2>&1 &
  fi
  exit 1
fi

vt_locked=0
if command -v physlock >/dev/null && sudo -n physlock -l >/dev/null 2>&1; then
  vt_locked=1
  trap 'sudo -n physlock -L >/dev/null 2>&1 || true' EXIT INT TERM HUP
fi

if command -v i3lock >/dev/null; then
  # Always a plain Tokyo Night fill — never the desktop wallpaper (i3lock may
  # otherwise keep the X root pixmap). Positions keep time, date and label apart.
  bg=/usr/share/rukeos/lock-background.png
  img=
  [ -f "$bg" ] && img="--image=$bg --fill"
  fade=
  anim=$(awk -F= '/^animations=/{print $2}' "${XDG_CONFIG_HOME:-$HOME/.config}/rukeos/appearance.conf" 2>/dev/null || true)
  if [ "$anim" != off ] && i3lock --help 2>&1 | grep -q fade-in; then
    fade="--fade-in=0.15"
  fi
  i3lock --nofork $fade \
    --ignore-empty-password \
    --show-failed-attempts \
    --indicator --clock \
    --color=1a1b26 \
    $img \
    --inside-color=1a1b26ff --ring-color=7B4FD6ff \
    --insidever-color=24283bff --ringver-color=7aa2f7ff \
    --insidewrong-color=24283bff --ringwrong-color=f7768eff \
    --line-color=00000000 --separator-color=00000000 \
    --keyhl-color=9ece6aff --bshl-color=f7768eff \
    --time-color=c0caf5ff --date-color=c0caf5ff \
    --greeter-color=c0caf5ff --verif-color=c0caf5ff \
    --wrong-color=f7768eff --modif-color=a9b1d6ff \
    --time-str="%H:%M" --date-str="%A, %d %B" \
    --greeter-text="rukeOS  ·  Locked" \
    --verif-text="Checking…" --wrong-text="Wrong password" --noinput-text="" \
    --time-font=Inter --date-font=Inter --greeter-font=Inter \
    --verif-font=Inter --wrong-font=Inter \
    --time-size=48 --date-size=16 --greeter-size=18 \
    --radius=110 --ring-width=8 \
    --ind-pos="w/2:h/2-24" \
    --time-pos="ix:iy-8" \
    --date-pos="ix:iy+28" \
    --greeter-pos="ix:iy+150" \
    --pass-media-keys --pass-screen-keys --pass-volume-keys
  rc=$?
elif command -v slock >/dev/null; then
  slock
  rc=$?
else
  rc=1
fi

[ "$vt_locked" = 1 ] && sudo -n physlock -L >/dev/null 2>&1 || true
exit ${rc:-0}
