#!/usr/bin/python3
"""status / set / change the desktop user's password. Run as root (sudo -n).

Writes /etc/shadow (login, lock screen, and any sudo that asks) and fsyncs
the file plus the rukeos-data persistence volume so the change survives reboot.
"""
from __future__ import annotations

import os
import subprocess
import sys

try:
    import crypt
except ImportError:
    crypt = None

try:
    import spwd
except ImportError:
    spwd = None


def target_user():
    for name in (os.environ.get("SUDO_USER"), os.environ.get("RUKE_USER")):
        name = (name or "").strip()
        if name and name != "root" and name != "nobody":
            return name
    # Primary desktop account (uid 1000), not root.
    try:
        for line in open("/etc/passwd", encoding="utf-8"):
            parts = line.split(":")
            if len(parts) >= 3 and parts[2] == "1000":
                return parts[0]
    except OSError:
        pass
    return ""


def shadow_hash(name):
    if spwd is not None:
        try:
            return spwd.getspnam(name).sp_pwdp
        except PermissionError:
            return None
        except KeyError:
            return ""
    p = subprocess.run(
        ["passwd", "-S", name],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    out = (p.stdout or "").split()
    if len(out) >= 2 and out[1] in ("NP", "NK", "Empty"):
        return ""
    return "?"


def is_empty(h):
    return (not h) or h in ("!", "*", "!!", "!*", "")


def crypt_check(password, hashed):
    """Return True if password matches the shadow hash."""
    if not hashed or hashed == "?":
        return False
    got = None
    if crypt is not None:
        try:
            got = crypt.crypt(password, hashed)
        except Exception:
            got = None
        if got is not None and got == hashed:
            return True
    # libc crypt(3) — covers yescrypt ($y$) on musl/libxcrypt when Python's
    # crypt module is missing or does not understand the method.
    try:
        import ctypes
        import ctypes.util
        lib = ctypes.CDLL(ctypes.util.find_library("crypt") or ctypes.util.find_library("c"))
        lib.crypt.restype = ctypes.c_char_p
        lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        got = lib.crypt(password.encode("utf-8"), hashed.encode("utf-8"))
        if got:
            return got.decode("utf-8", "replace") == hashed
    except Exception:
        pass
    return False


def persist_shadow():
    """Flush /etc/shadow to disk, including the USB persistence volume."""
    for path in ("/etc/shadow", "/etc/shadow-", "/etc/passwd", "/etc/passwd-"):
        try:
            fd = os.open(path, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        except OSError:
            pass
    try:
        os.sync()
    except Exception:
        pass
    persist = ""
    try:
        persist = open("/media/.persist-device", encoding="utf-8").read().strip()
    except OSError:
        persist = ""
    if persist and persist != "none":
        for target in ("/etc/shadow", "/media/.rw", "/"):
            subprocess.run(
                ["sync", "-f", target],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


def status(name):
    h = shadow_hash(name)
    if h is None:
        p = subprocess.run(
            ["passwd", "-S", name],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        out = (p.stdout or "").split()
        if len(out) >= 2 and out[1] in ("NP", "NK", "Empty"):
            print("none")
            return 0
        if len(out) >= 2 and out[1] in ("P", "PS"):
            print("set")
            return 0
        print("unknown")
        return 1
    print("none" if is_empty(h) else "set")
    return 0


def set_password(name, new):
    if not new:
        print("empty password is not allowed", file=sys.stderr)
        return 1
    p = subprocess.run(
        ["chpasswd"],
        input="%s:%s\n" % (name, new),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if p.returncode != 0:
        sys.stderr.write(p.stdout or "chpasswd failed\n")
        return p.returncode
    persist_shadow()
    return 0


def main(argv):
    if os.geteuid() != 0:
        print("ruke-passwd must run as root (sudo -n ruke-passwd …)", file=sys.stderr)
        return 1
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print("usage: ruke-passwd status|set|change", file=sys.stderr)
        return 2
    name = target_user()
    if not name or name == "root":
        print("no desktop user", file=sys.stderr)
        return 1
    cmd = argv[1]
    if cmd == "status":
        return status(name)
    data = sys.stdin.read().splitlines()
    if cmd == "set":
        h = shadow_hash(name)
        if h is not None and not is_empty(h):
            print("a password is already set; use change", file=sys.stderr)
            return 2
        new = data[0] if data else ""
        return set_password(name, new)
    if cmd == "change":
        if len(data) < 2:
            print("expected current password and new password", file=sys.stderr)
            return 2
        old, new = data[0], data[1]
        h = shadow_hash(name)
        if h is None:
            print("cannot read shadow", file=sys.stderr)
            return 1
        if not is_empty(h):
            if not crypt_check(old, h):
                print("current password is wrong", file=sys.stderr)
                return 3
        return set_password(name, new)
    print("unknown command", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
