#!/sbin/openrc-run
description="Show the rukeOS boot splash (logo, no console text)"
# Run after the framebuffer exists; again after the GPU driver loads.
depend() { after udev udev-settle modules; before hostname local; }

start() {
  # Always try: existing sticks may lack "splash" on the kernel command line.
  echo 1 >/proc/sys/kernel/printk 2>/dev/null || true
  for i in 1 2 3 4 5 6 7 8; do
    [ -e /sys/class/graphics/fb0/virtual_size ] && [ -c /dev/fb0 ] && break
    sleep 0.25
  done
  /usr/local/bin/ruke-splash >/dev/null 2>&1 || true
  return 0
}

stop() { return 0; }
